rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Public read for success stories on landing page
    match /success_stories/{storyId} {
      allow read: if true;
      allow write: if request.auth != null;
    }

    // Founder pass counter: public read so the landing page / paywall can show
    // the live claimed count. Writes are server-side only (Stripe webhook via
    // Admin SDK bypasses rules); clients may only increment by exactly 1 when
    // redeeming a founder promo code, capped at 199.
    match /stats/founder {
      allow read: if true;
      allow create: if request.auth != null
        && request.resource.data.claimed == 1
        && request.resource.data.keys().hasOnly(['claimed']);
      allow update: if request.auth != null
        && request.resource.data.claimed == resource.data.claimed + 1
        && request.resource.data.claimed <= 199
        && request.resource.data.keys().hasOnly(['claimed']);
    }

    // Promo code single-use claims: each issued code dies after its allowed
    // number of total redemptions across all accounts, so codes can never be
    // passed around and reused. Clients may only increment the counter by
    // exactly 1 with a fixed key shape; the app enforces the per-code limit
    // transactionally before granting anything.
    match /promo_code_claims/{code} {
      allow read: if true;
      allow create: if request.resource.data.keys().hasOnly(['code', 'uses', 'lastClaimedAt', 'lastClaimedBy'])
        && request.resource.data.uses == 1;
      allow update: if request.resource.data.keys().hasOnly(['code', 'uses', 'lastClaimedAt', 'lastClaimedBy'])
        && request.resource.data.uses == resource.data.uses + 1;
    }

    // Standard rule specified by user: authenticated access across all documents
    match /{document=**} {
      allow read, write: if request.auth != null;
    }
  }
}
